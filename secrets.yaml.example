# Example secrets.yaml structure
#
# This file should be encrypted with SOPS/Age before use.
#
# Setup:
#   1. Generate age key: age-keygen -o ~/.config/sops/age/keys.txt
#   2. Get your public key: grep 'public key:' ~/.config/sops/age/keys.txt
#   3. Update .sops.yaml with your public key
#   4. Copy this file: cp secrets.yaml.example secrets.yaml
#   5. Fill in your actual secrets in secrets.yaml
#   6. Encrypt: sops -e -i secrets.yaml
#
# To edit encrypted file later:
#   sops secrets.yaml
#
# To decrypt (for viewing):
#   sops -d secrets.yaml

ovh:
  # Create these at https://us.ovhcloud.com/auth/api/createToken
  # US customers: use us.ovhcloud.com
  # EU customers: use eu.api.ovh.com/createToken or eu.api.ovh.com/createApp
  application_key: "your_application_key_here"
  application_secret: "your_application_secret_here"
  consumer_key: "your_consumer_key_here"

  # OVH subsidiary for billing (US, CA, GB, FR, DE, etc.)
  # US customers should use "US"
  subsidiary: "US"

  # API endpoint (optional, defaults to ovh-us)
  # US customers: ovh-us
  # Other options: ovh-eu, ovh-ca, soyoustart-eu, soyoustart-ca, kimsufi-eu, kimsufi-ca
  endpoint: "ovh-us"

kamal:
  # GitHub username for registry and image naming
  github_username: "your-github-username"

  # Domain for your deployment (without https://)
  domain: "your-domain.com"

  # GitHub Container Registry token for pulling images from ghcr.io
  # Create at: https://github.com/settings/tokens
  # Required scope: read:packages
  registry_password: "your_github_pat_here"

ayb:
  # ayb server configuration secrets
  # These get injected as environment variables into the ayb container
  # Variable names use __ (double underscore) for nested config fields

  # Server configuration
  host: "0.0.0.0"
  port: "5433"
  public_url: "https://your-domain.com"
  database_url: "sqlite:///data/ayb.sqlite"
  data_path: "/data"

  # CORS configuration
  cors__origin: "https://your-domain.com"

  # Web hosting
  web__hosting_method: "Local"

  # Authentication (required)
  # Generate with: ayb default_server_config | grep fernet_key
  authentication__fernet_key: "your_fernet_key_here"
  authentication__token_expiration_seconds: "3600"

  # Email SMTP configuration (required)
  email__smtp__from: "ayb Server <ayb@example.com>"
  email__smtp__reply_to: "Support <support@example.com>"
  email__smtp__smtp_host: "smtp.example.com"
  email__smtp__smtp_port: "465"
  email__smtp__smtp_username: "your_smtp_username"
  email__smtp__smtp_password: "your_smtp_password"