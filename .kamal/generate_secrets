#!/usr/bin/env python3
"""
Generate .kamal/secrets from secrets.yaml structure

This script reads the decrypted secrets.yaml structure and generates
a .kamal/secrets file with command substitution for each secret.

Usage:
    .kamal/generate_secrets

The script will create/overwrite .kamal/secrets with the appropriate
command substitutions based on what's in secrets.yaml.
"""

import subprocess
import json
import sys
from pathlib import Path

def main():
    # Change to the directory containing this script
    script_dir = Path(__file__).parent
    deploy_dir = script_dir.parent

    secrets_yaml = deploy_dir / "secrets.yaml"
    output_file = script_dir / "secrets"

    # Check if secrets.yaml exists
    if not secrets_yaml.exists():
        print(f"Error: {secrets_yaml} not found", file=sys.stderr)
        print("Please create and encrypt secrets.yaml first", file=sys.stderr)
        sys.exit(1)

    # Check if sops is installed
    try:
        subprocess.run(["sops", "--version"], capture_output=True, check=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("Error: sops not found. Install with: brew install sops", file=sys.stderr)
        sys.exit(1)

    # Decrypt secrets.yaml to get structure
    try:
        result = subprocess.run(
            ["sops", "-d", "--output-type", "json", str(secrets_yaml)],
            capture_output=True,
            check=True,
            text=True
        )
        secrets = json.loads(result.stdout)
    except subprocess.CalledProcessError as e:
        print(f"Error decrypting secrets.yaml: {e.stderr}", file=sys.stderr)
        sys.exit(1)
    except json.JSONDecodeError as e:
        print(f"Error parsing secrets.yaml JSON: {e}", file=sys.stderr)
        sys.exit(1)

    # Generate .kamal/secrets content
    lines = [
        "# AUTO-GENERATED FILE - DO NOT EDIT MANUALLY",
        "# Generated by .kamal/generate_secrets from secrets.yaml",
        "#",
        "# To regenerate: .kamal/generate_secrets",
        "#",
        "# This file uses dotenv format with command substitution.",
        "# Kamal will execute the sops commands and substitute values when needed.",
        "",
    ]

    # Add Kamal-specific secrets
    if "kamal" in secrets:
        lines.append("# Kamal deployment secrets")
        for key, value in secrets["kamal"].items():
            env_key = f"KAMAL_{key.upper()}"
            json_path = f'["kamal"]["{key}"]'
            lines.append(f"{env_key}=$(sops -d --extract '{json_path}' secrets.yaml)")
        lines.append("")

    # Add ayb application secrets
    if "ayb" in secrets:
        lines.append("# ayb application secrets")
        for key, value in secrets["ayb"].items():
            # Convert key to environment variable format (ayb requires AYB__ prefix with double underscores)
            env_key = f"AYB__{key.upper()}"
            json_path = f'["ayb"]["{key}"]'
            lines.append(f"{env_key}=$(sops -d --extract '{json_path}' secrets.yaml)")
        lines.append("")

    # Write to .kamal/secrets
    output_file.write_text("\n".join(lines))
    output_file.chmod(0o755)

    print(f"✓ Generated {output_file}")
    print(f"  Found {len(secrets.get('kamal', {}))} Kamal secrets")
    print(f"  Found {len(secrets.get('ayb', {}))} ayb secrets")

if __name__ == "__main__":
    main()
